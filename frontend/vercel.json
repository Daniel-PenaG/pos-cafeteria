{
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "//login",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": false
    }
  ]
}
